GEMINI_API_KEY=your_gemini_api_key_here

# Optional official OpenAI provider. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# The submitted and reproduced workflow uses Gemini. Judges may switch this to
# openai after supplying their own OPENAI_API_KEY, or to auto with both keys.
OCULAR_AI_PROVIDER=gemini
