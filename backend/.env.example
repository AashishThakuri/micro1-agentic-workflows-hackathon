GEMINI_API_KEY=your_gemini_api_key_here

# Optional official OpenAI provider. Never commit a real key.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.2
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# auto uses OpenAI first when OPENAI_API_KEY is set, then Gemini as fallback.
# Set to openai or gemini to force one provider.
OCULAR_AI_PROVIDER=auto
